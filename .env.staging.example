# ==============================================================================
# Staging Environment Configuration (.env.staging)
# ==============================================================================

# General
NODE_ENV=staging

# Backend Service
PORT=5000
MONGO_URI=mongodb://mongo-staging:27017/ecommerce_staging
CLIENT_URL=https://staging.example.com
JWT_SECRET=replace_with_staging_secret_key

# Frontend Service
VITE_API_BASE_URL=https://api-staging.example.com/api
