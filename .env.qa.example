# ==============================================================================
# QA Environment Configuration (.env.qa)
# ==============================================================================

# General
NODE_ENV=qa

# Backend Service
PORT=5000
MONGO_URI=mongodb://mongo-qa:27017/ecommerce_qa
CLIENT_URL=https://qa.example.com
JWT_SECRET=replace_with_qa_secret_key

# Frontend Service
VITE_API_BASE_URL=https://api-qa.example.com/api
